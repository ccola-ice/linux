# Kernel config fragment for the custom F1C200s board (suniv, ARM926EJ-S).
#
# Usage (from the kernel source root, with an ARMv5 cross toolchain):
#   make ARCH=arm CROSS_COMPILE=arm-linux-gnueabi- O=build-arm multi_v5_defconfig
#   ./scripts/kconfig/merge_config.sh -O build-arm build-arm/.config myboard/kernel.config
#   make ARCH=arm CROSS_COMPILE=arm-linux-gnueabi- O=build-arm olddefconfig zImage dtbs modules
#
# Resulting images:
#   build-arm/arch/arm/boot/zImage
#   build-arm/arch/arm/boot/dts/allwinner/suniv-f1c200s-myboard.dtb

# --- SoC platform ---
CONFIG_ARCH_MULTI_V5=y
CONFIG_ARCH_SUNXI=y
CONFIG_MACH_SUNIV=y
CONFIG_SUN4I_INTC=y
CONFIG_SUN4I_TIMER=y
CONFIG_SUNIV_F1C100S_CCU=y
CONFIG_PINCTRL_SUNIV_F1C100S=y
CONFIG_SUNXI_SRAM=y
CONFIG_SUNXI_WATCHDOG=y

# --- Console (dw-apb-uart) ---
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_OF_PLATFORM=y

# --- Storage ---
CONFIG_MMC=y
CONFIG_MMC_SUNXI=y
CONFIG_SPI=y
CONFIG_SPI_SUN6I=y
CONFIG_MTD=y
CONFIG_MTD_SPI_NAND=y

# --- I2C + MPU-6050 (mainline IIO driver) ---
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_MV64XXX=y
CONFIG_REGMAP_I2C=y
CONFIG_IIO=y
CONFIG_IIO_BUFFER=y
CONFIG_IIO_TRIGGERED_BUFFER=y
CONFIG_IIO_SYSFS_TRIGGER=y
CONFIG_INV_MPU6050_IIO=y
CONFIG_INV_MPU6050_I2C=y

# --- LCD: ILI9341 SPI panel on spi1 + PWM backlight ---
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_MIPI_DBI=y
CONFIG_TINYDRM_ILI9341=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_PWM=y
CONFIG_PWM_SUN4I=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y

# --- USB gadget (FEL runs from BROM; this is for runtime USB) ---
CONFIG_USB_SUPPORT=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_SUNXI=y
CONFIG_PHY_SUN4I_USB=y
CONFIG_USB_GADGET=y

# --- Rootfs on TF card ---
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
